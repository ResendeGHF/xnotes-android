<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- On Android 12+, theme the system splash like a customary launch:
         app icon on the dark stage, dismissed on the first frame. -->
    <style name="Theme.Xnotes.Splash" parent="Theme.Xnotes">
        <item name="android:windowBackground">@color/loader_bg</item>
        <item name="android:windowSplashScreenBackground">@color/loader_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
